---
// GitHub Pages serves this page (built as 404.html) for any address that
// doesn't exist on the site.
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Page not found · Will Ford" description="This page doesn't exist." noindex>
  <section class="container not-found">
    <p class="code">
      404 <Icon name="football" class="ball" />
    </p>
    <h1>Fumble.</h1>
    <p>This page doesn't exist. It may have moved, or the link might have a typo.</p>
    <p class="actions">
      <a class="link-sweep" href="/">Go to the homepage</a>
      <a class="link-sweep" href="/#projects">See my projects</a>
    </p>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: var(--space-24);
  }

  .code {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--colour-accent);
  }

  .code :global(.ball) {
    width: 1.75rem;
    height: 1.75rem;
  }

  /* The loose ball tumbles once as the page loads, then lies still */
  @media (prefers-reduced-motion: no-preference) {
    .code :global(.ball) {
      animation: tumble 900ms cubic-bezier(0.3, 0.7, 0.4, 1) 200ms both;
    }
  }

  @keyframes tumble {
    0% {
      transform: translate(-1.5rem, -0.5rem) rotate(-200deg);
      opacity: 0;
    }
    40% {
      opacity: 1;
    }
    70% {
      transform: translate(0.15rem, 0) rotate(12deg);
    }
    100% {
      transform: none;
    }
  }

  h1 {
    margin-block: var(--space-2) var(--space-4);
    font-size: var(--text-hero);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin-top: var(--space-8);
    font-weight: 600;
  }
</style>
