---
// Homepage. All text comes from the files in src/content/; this page only
// decides the order of the sections. Sections still marked as
// placeholders get built in later steps.
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import ProjectList from '../components/ProjectList.astro';

const site = await getEntry('site', 'main');
if (!site) throw new Error('src/content/site.yaml is missing');
const { data } = site;
const stats = await getCollection('stats');
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const placeholders = [
  { id: 'experience', title: 'Experience', step: 4 },
  { id: 'education', title: 'Education', step: 4 },
  { id: 'skills', title: 'Skills', step: 4 },
  { id: 'outside', title: 'Outside of code', step: 5 },
  { id: 'cv', title: 'CV', step: 5 },
  { id: 'contact', title: 'Contact', step: 5 },
];
---

<BaseLayout
  title={`${data.name} · ${data.role}`}
  description={`${data.intro} ${data.lookingFor}`}
>
  <Hero site={data} stats={stats} />

  <Section id="about" title="About">
    <p class="bio">{data.bio}</p>
  </Section>

  <Section id="projects" title="Projects">
    <ProjectList projects={projects} />
  </Section>

  {placeholders.map((section) => (
    <Section id={section.id} title={section.title}>
      <p class="muted">Built in step {section.step}.</p>
    </Section>
  ))}
</BaseLayout>

<style>
  .bio {
    max-width: var(--text-width);
    font-size: var(--text-lg);
  }

  .muted {
    color: var(--colour-text-muted);
  }
</style>
