---
// Homepage. Step 1 skeleton: the hero reads from site.yaml to prove the
// content pipeline works; the other sections are placeholders that get
// built out in later steps.
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const site = await getEntry('site', 'main');
if (!site) throw new Error('src/content/site.yaml is missing');
const { data } = site;

const sections = [
  { id: 'about', title: 'About', step: 2 },
  { id: 'projects', title: 'Projects', step: 3 },
  { id: 'experience', title: 'Experience', step: 4 },
  { id: 'education', title: 'Education', step: 4 },
  { id: 'skills', title: 'Skills', step: 4 },
  { id: 'outside', title: 'Outside of code', step: 5 },
  { id: 'cv', title: 'CV', step: 5 },
  { id: 'contact', title: 'Contact', step: 5 },
];
---

<BaseLayout
  title={`${data.name} · Computer Science student`}
  description={`${data.role}. ${data.lookingFor}`}
>
  <section class="container hero">
    <h1>
      {data.headline}
      <span class="accent">{data.headlineAccent}</span>
    </h1>
    <p>{data.role}. {data.lookingFor}</p>
    <p class="muted">{data.location}</p>
  </section>

  {sections.map((section) => (
    <section id={section.id} class="container placeholder">
      <h2>{section.title}</h2>
      <p class="muted">Built in step {section.step}.</p>
    </section>
  ))}
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-16);
  }

  .hero h1 {
    font-size: var(--text-hero);
    max-width: 14ch;
    margin-bottom: var(--space-6);
  }

  .accent {
    display: block;
    color: var(--colour-accent);
  }

  .hero p {
    max-width: var(--text-width);
    font-size: var(--text-lg);
  }

  .placeholder {
    padding-block: var(--space-8);
  }

  .placeholder h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-2);
  }

  .muted {
    color: var(--colour-text-muted);
  }
</style>
