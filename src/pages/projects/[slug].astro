---
// One page per project. getStaticPaths() runs at build time and returns a
// route for every file in src/content/projects/, so adding a project file
// automatically creates its page at /projects/<file name>/.
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
---

<BaseLayout title={`${data.title} · Will Ford`} description={data.summary} type="article">
  <article class="container project">
    <a class="back" href="/#projects">← All projects</a>

    <header class="header">
      <h1>{data.title}</h1>
      <StatusBadge status={data.status} note={data.statusNote} />
      <p class="summary">{data.summary}</p>
    </header>

    {
      data.image && (
        <Image
          class="image"
          src={data.image}
          alt={data.imageAlt ?? ''}
          widths={[480, 640, 960]}
          sizes="(min-width: 44rem) 640px, 100vw"
          loading="eager"
        />
      )
    }

    <div class="layout">
      <aside class="facts" aria-label="Project details">
        <dl>
          <dt>My role</dt>
          <dd>{data.role}</dd>
          <dt>Built with</dt>
          <dd>
            <ul class="tech">
              {data.tech.map((item) => <li>{item}</li>)}
            </ul>
          </dd>
          {
            (data.demo || data.repo) && (
              <>
                <dt>Links</dt>
                <dd class="links">
                  {data.demo && <a href={data.demo}>Try it</a>}
                  {data.repo && <a href={data.repo}>Code on GitHub</a>}
                </dd>
              </>
            )
          }
        </dl>
      </aside>

      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .project {
    padding-top: var(--space-8);
  }

  .back {
    display: inline-block;
    margin-bottom: var(--space-8);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .back:hover {
    text-decoration: underline;
  }

  .header {
    margin-bottom: var(--space-12);
  }

  h1 {
    font-size: var(--text-hero);
    margin-bottom: var(--space-3);
  }

  .summary {
    max-width: var(--text-width);
    margin-top: var(--space-4);
    font-size: var(--text-lg);
  }

  /* Screenshots stay at reading width so tall images don't fill the
     screen, and small ones are never stretched past their real size */
  .image {
    width: auto;
    max-width: min(100%, var(--text-width));
    margin-bottom: var(--space-12);
    border: 1px solid var(--colour-border);
    border-radius: var(--radius);
  }

  .layout {
    display: grid;
    gap: var(--space-12);
  }

  @media (min-width: 56rem) {
    .layout {
      grid-template-columns: minmax(0, var(--text-width)) 16rem;
      justify-content: space-between;
    }

    /* Details sit on the right on wide screens, but come first on phones */
    .facts {
      grid-column: 2;
      grid-row: 1;
    }
  }

  .facts dl {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-6);
    background: var(--colour-surface);
    border-radius: var(--radius);
    font-size: var(--text-sm);
  }

  dt {
    font-weight: 600;
    color: var(--colour-text-muted);
  }

  dt:not(:first-child) {
    margin-top: var(--space-4);
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-1);
    padding: 0;
    list-style: none;
  }

  .tech li {
    padding: 0 var(--space-2);
    background: var(--colour-chip-bg);
    color: var(--colour-chip-text);
    border-radius: 4px;
  }

  .links {
    display: grid;
    gap: var(--space-1);
    font-weight: 600;
  }

  /* Styles for the Markdown write-up. :global() is needed because the
     HTML comes from the Markdown file, not from this component. */
  .prose :global(h2) {
    font-size: var(--text-xl);
    margin: var(--space-12) 0 var(--space-3);
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(table) {
    margin-bottom: var(--space-4);
  }

  .prose :global(ul) {
    padding-left: var(--space-6);
  }

  .prose :global(li + li) {
    margin-top: var(--space-2);
  }

  .prose :global(code) {
    padding: 0.1em 0.3em;
    background: var(--colour-surface);
    border-radius: 4px;
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    font-size: 0.9em;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .prose :global(th),
  .prose :global(td) {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--colour-border);
  }

  .prose :global(th) {
    font-weight: 600;
    text-align: left;
  }
</style>
