---
// Homepage project cards. The first project is "featured": a wide card with
// its visual beside the text. The rest sit side by side underneath.
// Each card shows a screenshot or, if the project has chart data, a chart.
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import StatusBadge from './StatusBadge.astro';
import BarChart from './BarChart.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<ul class="projects">
  {
    projects.map((project, index) => {
      const { data } = project;
      const href = `/projects/${project.id}/`;
      const featured = index === 0;
      return (
        <li class:list={['item', { featured }]} data-reveal-item>
          <article class="card">
            {(data.image || data.chart) && (
              <div class:list={['visual', { 'has-chart': !data.image }]}>
                {data.image ? (
                  <Image
                    src={data.image}
                    alt={data.imageAlt ?? ''}
                    widths={[400, 640, 960]}
                    sizes={featured ? '(min-width: 56rem) 400px, 100vw' : '(min-width: 40rem) 400px, 100vw'}
                  />
                ) : (
                  data.chart && <BarChart title={data.chart.title} bars={data.chart.bars} />
                )}
              </div>
            )}
            <div class="content">
              <div class="heading">
                <h3>
                  {/* This link stretches over the whole card (see .card-link
                      below), so clicking anywhere on the card opens it */}
                  <a class="card-link" href={href}>
                    {data.title}<span class="arrow" aria-hidden="true">→</span>
                  </a>
                </h3>
                <StatusBadge status={data.status} note={data.statusNote} />
              </div>
              <p class="summary">{data.summary}</p>
              <p class="tech">
                <span class="visually-hidden">Built with: </span>
                {data.tech.join(' · ')}
              </p>
              <p class="links">
                {data.demo && (
                  <a href={data.demo}>
                    Try it<span class="visually-hidden">: {data.title}</span>
                  </a>
                )}
                {data.repo && (
                  <a href={data.repo}>
                    Code<span class="visually-hidden"> for {data.title} on GitHub</span>
                  </a>
                )}
              </p>
            </div>
          </article>
        </li>
      );
    })
  }
</ul>

<style>
  .projects {
    display: grid;
    gap: var(--space-6);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .projects {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .featured {
      grid-column: 1 / -1;
    }
  }

  .item {
    display: flex;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow: hidden;
    background: var(--colour-card);
    border: 1px solid var(--colour-border);
    border-radius: 12px;
  }

  .visual {
    aspect-ratio: 16 / 10;
    background: var(--colour-surface);
    border-bottom: 1px solid var(--colour-border);
  }

  /* Featured card: visual on the right of the text on wide screens */
  @media (min-width: 56rem) {
    .featured .card {
      flex-direction: row-reverse;
    }

    .featured .visual {
      flex: 0 0 45%;
      aspect-ratio: auto;
      border-bottom: none;
      border-left: 1px solid var(--colour-border);
    }
  }

  .visual :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
  }

  .has-chart {
    display: flex;
    align-items: center;
    padding: var(--space-6);
  }

  .has-chart :global(.chart) {
    width: 100%;
  }

  .content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-6);
  }

  .heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-2);
  }

  h3 {
    font-size: clamp(1.625rem, 1.4rem + 1vw, 2.125rem);
  }

  .featured h3 {
    font-size: clamp(1.875rem, 1.5rem + 1.5vw, 2.75rem);
  }

  h3 a {
    color: var(--colour-text);
    text-decoration: none;
  }

  /* The "stretched link": an invisible box over the whole card */
  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 12px;
  }

  /* The focus ring goes round the whole card, not just the title */
  .card-link:focus-visible {
    outline: none;
  }

  .card-link:focus-visible::after {
    outline: 3px solid var(--colour-focus);
    outline-offset: -3px;
  }

  .summary {
    max-width: var(--text-width);
    margin-bottom: var(--space-2);
  }

  .tech {
    color: var(--colour-text-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
  }

  /* Pushed to the bottom so links line up across cards of different heights.
     They sit above the stretched link so they stay clickable on their own. */
  .links {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin-top: auto;
    font-weight: 600;
  }

  .links:empty {
    display: none;
  }

  /* Hover/focus: the card lifts with a soft shadow and an arrow slides in */
  /* The arrow takes up no width, so a hidden arrow never pushes a long
     title onto a second line; it's drawn just past the end of the title */
  .arrow {
    display: inline-block;
    width: 0;
    white-space: nowrap;
    color: var(--colour-accent);
    opacity: 0;
    transform: translateX(0);
  }

  .card:hover,
  .card:focus-within {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
    border-color: var(--colour-accent);
  }

  .card:hover .arrow,
  .card:focus-within .arrow {
    opacity: 1;
    transform: translateX(0.3em);
  }

  @media (prefers-reduced-motion: no-preference) {
    .card {
      transition:
        transform 250ms ease,
        box-shadow 250ms ease,
        border-color 250ms ease;
    }

    .arrow {
      transition:
        opacity 200ms ease,
        transform 250ms ease;
    }
  }
</style>
