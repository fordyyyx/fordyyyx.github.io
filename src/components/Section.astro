---
// Shared wrapper for every homepage section (About, Projects, ...).
// On wide screens the heading sits in a narrow left column and the
// content in a wider right column; on phones they simply stack.
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
const headingId = `${id}-heading`;
---

<section id={id} class="container section" aria-labelledby={headingId} data-reveal>
  <h2 id={headingId}>{title}</h2>
  <div class="body">
    <slot />
  </div>
</section>

<style>
  .section {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-12);
    border-top: 1px solid var(--colour-border);
    scroll-margin-top: var(--space-4);
  }

  /* Section headings act as labels, so they stay smaller than the
     headlines inside sections (like project titles) */
  h2 {
    font-size: 1.375rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--colour-accent);
  }

  @media (min-width: 48rem) {
    .section {
      grid-template-columns: 12rem minmax(0, 1fr);
      gap: var(--space-8);
      padding-block: var(--space-16);
      /* Leave room for the sticky header when jumping to a section */
      scroll-margin-top: 5rem;
    }

    h2 {
      /* Line the heading's top up with the first line of the content */
      padding-top: 0.15em;
    }
  }
</style>
