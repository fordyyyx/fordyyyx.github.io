---
// The first thing a visitor sees: headline, who I am, what I'm looking
// for, and the stat chips.
import type { CollectionEntry } from 'astro:content';
import StatChips from './StatChips.astro';

interface Props {
  site: CollectionEntry<'site'>['data'];
  stats: CollectionEntry<'stats'>[];
}

const { site, stats } = Astro.props;
---

<section class="hero" aria-labelledby="hero-heading">
  {/* Decorative route line, like a GPS trace or a delivery route, drawn
      behind the hero. pathLength="1" lets CSS animate it being "drawn". */}
  <svg class="route" viewBox="0 0 1000 500" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
    <path
      pathLength="1"
      d="M -10 455 C 90 440, 150 482, 240 462 S 400 418, 480 446 S 620 494, 700 452 S 820 382, 880 300 S 960 140, 1010 110"
    />
  </svg>

  <div class="container inner">
    <div class="text">
      <h1 id="hero-heading">
        {site.headline}{' '}
        <span class="accent">{site.headlineAccent}</span>
      </h1>
      <p class="intro">{site.intro}</p>
      <p class="looking-for">{site.lookingFor}</p>
      <p class="location">{site.location}</p>
      <div class="actions">
        <a class="button primary" href="#projects">
          View projects <span class="arrow" aria-hidden="true">↓</span>
        </a>
        {
          site.cv ? (
            <a class="button secondary" href={site.cv} download>
              Download CV <span class="file-type">(PDF)</span>
            </a>
          ) : (
            <a class="button secondary" href="#contact">Get in touch</a>
          )
        }
      </div>
    </div>
    <StatChips stats={stats} />
  </div>
</section>

<style>
  /* `isolation` keeps the route line's negative z-index inside the hero,
     so it sits behind the text but not behind the page itself */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .inner {
    display: grid;
    gap: var(--space-12);
    padding-block: var(--space-12) var(--space-16);
  }

  @media (min-width: 56rem) {
    .inner {
      grid-template-columns: minmax(0, 1fr) 17rem;
      align-items: end;
      gap: var(--space-16);
      padding-block: var(--space-24);
    }
  }

  /* The route line is only shown on wide screens, where it has room to run
     underneath the text instead of through it */
  .route {
    display: none;
  }

  @media (min-width: 56rem) {
    .route {
      display: block;
      position: absolute;
      inset: 0;
      z-index: -1;
      width: 100%;
      height: 100%;
    }
  }

  .route path {
    fill: none;
    stroke: var(--colour-accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    opacity: 0.45;
    /* One dash as long as the whole path: shifting it draws the line */
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  h1 {
    font-size: var(--text-hero);
    text-wrap: balance;
    margin-bottom: var(--space-6);
  }

  .accent {
    display: block;
    color: var(--colour-accent);
  }

  .intro {
    max-width: var(--text-width);
    font-size: var(--text-lg);
    margin-bottom: var(--space-4);
  }

  .looking-for,
  .location {
    max-width: var(--text-width);
    color: var(--colour-text-muted);
  }

  .location {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .button {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    border: 2px solid var(--colour-accent);
    border-radius: var(--radius);
    font-weight: 600;
    text-decoration: none;
  }

  .primary {
    background: var(--colour-accent);
    color: var(--colour-bg);
  }

  .primary:hover {
    background: var(--colour-accent-hover);
    border-color: var(--colour-accent-hover);
    color: var(--colour-bg);
  }

  /* The arrow nudges down on hover/focus, hinting at the jump down the page */
  .arrow {
    display: inline-block;
    margin-left: var(--space-1);
  }

  .primary:hover .arrow,
  .primary:focus-visible .arrow {
    transform: translateY(0.2em);
  }

  @media (prefers-reduced-motion: no-preference) {
    .arrow {
      transition: transform 250ms cubic-bezier(0.2, 0.7, 0.2, 1);
    }
  }

  .secondary:hover {
    background: var(--colour-chip-bg);
  }

  .file-type {
    font-weight: 400;
  }

  /* Entrance on page load: each part fades up shortly after the one
     before it. Pure CSS, so nothing stays hidden if JavaScript fails, and
     skipped entirely for visitors who prefer reduced motion. Each part
     sets its own --hero-delay, which the shared animation rule reads. */
  @media (prefers-reduced-motion: no-preference) {
    .text > *,
    .inner > :global(.stat-chips) {
      animation: hero-in 700ms cubic-bezier(0.2, 0.7, 0.2, 1) var(--hero-delay, 0ms) both;
    }

    /* The route line draws itself in after the text has arrived */
    .route path {
      animation: route-draw 2600ms ease-in-out 500ms both;
    }
  }

  .intro {
    --hero-delay: 120ms;
  }

  .looking-for,
  .location {
    --hero-delay: 220ms;
  }

  .actions {
    --hero-delay: 320ms;
  }

  .inner > :global(.stat-chips) {
    --hero-delay: 450ms;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  @keyframes route-draw {
    from {
      stroke-dashoffset: 1;
    }
  }
</style>
