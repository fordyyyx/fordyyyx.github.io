---
// The shared page shell: <head>, skip link, header and footer.
// Every page wraps its content in this layout, so these only exist once.
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/barlow-condensed/600.css';
import '../styles/global.css';
import { getEntry } from 'astro:content';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  /** "website" for the homepage, "article" for project pages */
  type?: 'website' | 'article';
  /** Keep the page out of search results (used by the 404 page) */
  noindex?: boolean;
}

const { title, description, type = 'website', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Shown when a link to the site is shared (LinkedIn, Slack, iMessage...).
// Generated by `npm run images` (see scripts/generate-images.mjs).
const socialImage = new URL('/og-image.png', Astro.site);
const site = (await getEntry('site', 'main'))?.data;
const siteName = site?.name ?? 'Will Ford';
const socialImageAlt = site ? `${site.name}: ${site.headline} ${site.headlineAccent}` : siteName;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!--
      Runs before the page is drawn, so revealed content is hidden before it
      can flash on screen. Skipped if the visitor prefers reduced motion.
      Safety net: if the reveal script hasn't started within 3 seconds,
      the class is removed and everything is shown.
    -->
    <script is:inline>
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const root = document.documentElement;
        root.classList.add('js-reveal');
        setTimeout(() => {
          if (!('revealReady' in root.dataset)) root.classList.remove('js-reveal');
        }, 3000);
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <!-- Icons: SVG for modern browsers, PNGs for older ones and iOS -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1114" media="(prefers-color-scheme: dark)" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph: controls the preview card when a link is shared -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Lets individual pages add extra tags (e.g. structured data) -->
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<script>
  // Scroll reveal: watches each [data-reveal] section and adds `is-visible`
  // the first time it scrolls into view (see global.css for the styles).
  const root = document.documentElement;

  if (root.classList.contains('js-reveal')) {
    root.dataset.revealReady = '';

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target); // reveal once, then leave it alone
        }
      },
      // Trigger slightly before the section's top reaches the bottom of the screen
      { rootMargin: '0px 0px -10% 0px' },
    );

    for (const section of document.querySelectorAll<HTMLElement>('[data-reveal]')) {
      // Number the items so CSS can stagger them (capped so long lists don't drag)
      section.querySelectorAll<HTMLElement>('[data-reveal-item]').forEach((item, index) => {
        item.style.setProperty('--reveal-index', String(Math.min(index, 5)));
      });
      observer.observe(section);
    }
  }
</script>

<style>
  /* Off-screen until a keyboard user tabs to it */
  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: -100%;
    z-index: 10;
    padding: var(--space-2) var(--space-4);
    background: var(--colour-accent);
    color: var(--colour-bg);
    font-weight: 600;
    border-radius: var(--radius);
  }

  .skip-link:focus {
    top: var(--space-4);
  }
</style>
